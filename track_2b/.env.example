# Copy this file to .env before running a live Apertus test.
# Never commit the local .env file. Values below are placeholders only.

# LLM / Apertus
LLM_NAME=swiss-ai/Apertus-v1.5-8B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=REPLACE_LOCALLY

# Optional Telegram control or notification channel (not implemented yet).
TELEGRAM_BOT_TOKEN=REPLACE_LOCALLY
TELEGRAM_ALLOWED_CHAT_IDS=REPLACE_LOCALLY

# Optional inbound mailbox access (not implemented yet; read-only by default).
IMAP_HOST=mail.example.invalid
IMAP_PORT=993
IMAP_USERNAME=REPLACE_LOCALLY
IMAP_PASSWORD=REPLACE_LOCALLY

# Optional outbound email provider (not implemented yet; sending stays disabled).
SMTP_HOST=smtp.example.invalid
SMTP_PORT=465
SMTP_USERNAME=REPLACE_LOCALLY
SMTP_PASSWORD=REPLACE_LOCALLY
SMTP_FROM_ADDRESS=sender@example.invalid
SMTP_FROM_NAME=REPLACE_LOCALLY

# Safe delivery defaults. Do not change until the delivery adapter, its tests and
# a separate operational approval are in place.
EMAIL_DELIVERY_MODE=draft_only
EMAIL_SEND_ENABLED=false
